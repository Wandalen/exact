#!/usr/bin/env bash
#@ purpose: Leveled full-suite verification — nextest, doctests, clippy, udeps, audit.
#@          level::N (1-5, default 3) selects how far the chain runs, mirroring
#@          `will .test level::N`. Final verification only — use test_only for
#@          filtered, in-progress checks.
#@ tags: verb, test
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

_level=3
_dry_run=0
for _arg in "$@"; do
  case "$_arg" in
    level::*) _level="${_arg#level::}" ;;
    dry::1)   _dry_run=1 ;;
    *)
      echo "verb/test: unrecognized parameter '$_arg' — expected level::N or dry::1" >&2
      exit 2
      ;;
  esac
done

if ! [[ "$_level" =~ ^[1-5]$ ]]; then
  echo "verb/test: level::$_level is not one of 1-5" >&2
  exit 2
fi

STEPS_1=( 'RUSTFLAGS="-D warnings" cargo nextest run --all-features' )
STEPS_2=( "${STEPS_1[@]}" 'RUSTDOCFLAGS="-D warnings" cargo test --doc --all-features' )
STEPS_3=( "${STEPS_2[@]}" 'cargo clippy --all-targets --all-features -- -D warnings' )
STEPS_4=( "${STEPS_3[@]}" 'cargo +nightly udeps --all-targets --all-features' '( if [ -f Cargo.lock ]; then cargo +nightly audit; else echo "no Cargo.lock — skipping audit"; fi )' )
# This family has no equivalent of ring's bench_harness/gate corpus suite (no G1-G21
# analog exists for exact), and CLAUDE.md's own canonical Level 5 (`will .test dry:0`)
# does not run as written against this workspace — will's own CLI rejects `dry:0`;
# its parameters use `::`, not `:`. Substituted with this family's own maximal check
# instead: a full clean rustdoc rebuild, which levels 1-4 never exercise and which
# catches broken intra-doc links that an incremental `cargo doc` would hide.
STEPS_5=( "${STEPS_4[@]}" './verb/doc' )

case "$_level" in
  1) STEPS=( "${STEPS_1[@]}" ) ;;
  2) STEPS=( "${STEPS_2[@]}" ) ;;
  3) STEPS=( "${STEPS_3[@]}" ) ;;
  4) STEPS=( "${STEPS_4[@]}" ) ;;
  5) STEPS=( "${STEPS_5[@]}" ) ;;
esac

if (( _dry_run )); then
  printf '%s\n' "${STEPS[@]}"
  exit 0
fi

for step in "${STEPS[@]}"; do
  eval "$step"
done
